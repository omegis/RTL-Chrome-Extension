{
  "manifest_version": 3,
  "name": "Rotem Daily RTL",
  "version": "2.8.0",
  "description": "Automatically applies RTL text direction for Hebrew content on supported websites, plus any element you pick on any site.",
  "author": "Rotem Bar",
  "homepage_url": "https://github.com/omegis/RTL-Chrome-Extension",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "custom-rules.js"]
    }
  ]
}
